# Vehicle image of example_ugv, generated by `fieldproof vehicle dockerfile` from
# robot.yaml; regenerate, do not edit.
#
# Stage `build`: the base image plus the ROS build tools; the vehicle's sources (local
# directories from the `vehicle-source` build context, repositories at pinned
# commits through vcs) land in /opt/vehicle_ws/src, rosdep resolves their dependencies
# against one pinned commit of ros/rosdistro, colcon builds them into /opt/vehicle
# (merge-install). Stage `runtime`: the base image, the run-time dependencies rosdep
# resolved, the install space, the entry point and the manifest, as the base image's
# non-root user.
ARG BASE_IMAGE=ghcr.io/dimitrios-kafetzis/fieldproof-base-ros2:main
# hadolint ignore=DL3006
FROM ${BASE_IMAGE} AS build
ARG ROSDISTRO_COMMIT=8e9a99d200fd312f106418b2b497b0cc5146e6a7
# This stage only builds; the runtime stage below switches back to the non-root user.
# hadolint ignore=DL3002
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Build tools from the snapshots the base image is pinned to (DL3008 and DL3009 as in
# the base image: versions come from the snapshots, whose lists stay in the image).
# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    fieldproof-apt-install build-essential cmake git python3-colcon-common-extensions python3-rosdep python3-vcstool

# rosdep against one commit of ros/rosdistro, so the same keys resolve to the same
# packages on every build (`rosdep init` would point at master).
RUN mkdir -p /etc/ros/rosdep/sources.list.d \
    && printf 'yaml https://raw.githubusercontent.com/ros/rosdistro/%s/rosdep/base.yaml\nyaml https://raw.githubusercontent.com/ros/rosdistro/%s/rosdep/python.yaml\n' \
        "${ROSDISTRO_COMMIT}" "${ROSDISTRO_COMMIT}" > /etc/ros/rosdep/sources.list.d/20-default.list \
    && ROSDISTRO_INDEX_URL="https://raw.githubusercontent.com/ros/rosdistro/${ROSDISTRO_COMMIT}/index-v4.yaml" \
        rosdep update --rosdistro "${ROS_DISTRO}"

WORKDIR /opt/vehicle_ws
# Local sources `src` of the manifest's directory (`vehicle-source` context).
# hadolint ignore=DL3022
COPY --from=vehicle-source src/ src/src/

# Dependencies: rosdep lists the apt packages of every package in src/ (the run-time
# ones are kept for the runtime stage) and fieldproof-apt-install fetches them in
# parallel. A key that resolves to another installer (pip) fails the build: vendor it or
# skip it.
# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    rosdep install --simulate --reinstall --from-paths src --ignore-src --rosdistro "${ROS_DISTRO}" > /tmp/deps.txt \
    && rosdep install --simulate --reinstall --from-paths src --ignore-src --rosdistro "${ROS_DISTRO}" --dependency-types exec > /tmp/exec-deps.txt \
    && if grep -E '^#\[' /tmp/deps.txt | grep -qv '^#\[apt\]'; then \
        echo 'dependencies need an installer other than apt:' >&2; \
        grep -E '^#\[' /tmp/deps.txt >&2; exit 1; fi \
    && sed -n 's/^ *\(sudo -H \)\{0,1\}apt-get install \(-y \)\{0,1\}//p' /tmp/deps.txt | sort -u > /tmp/apt.txt \
    && sed -n 's/^ *\(sudo -H \)\{0,1\}apt-get install \(-y \)\{0,1\}//p' /tmp/exec-deps.txt | sort -u > /tmp/.fieldproof-exec-deps.txt \
    && if [ -s /tmp/apt.txt ]; then xargs -a /tmp/apt.txt fieldproof-apt-install; fi

# Build and install into one install space; the run-time dependency list goes with it.
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && colcon build --merge-install --install-base /opt/vehicle \
        --event-handlers console_cohesion+ desktop_notification- status- \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && mv /tmp/.fieldproof-exec-deps.txt /opt/vehicle/.fieldproof-exec-deps.txt

# hadolint ignore=DL3006
FROM ${BASE_IMAGE} AS runtime
ARG FIELDPROOF_USER=fieldproof
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=build /opt/vehicle /opt/vehicle
# Run-time dependencies of the packages built, from the same snapshots as the base.
# hadolint ignore=DL3008,DL3009
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    if [ -s /opt/vehicle/.fieldproof-exec-deps.txt ]; then xargs -a /opt/vehicle/.fieldproof-exec-deps.txt fieldproof-apt-install; fi

COPY --chmod=755 entrypoint.sh /usr/local/bin/fieldproof-vehicle-entrypoint
# The directory first: --chmod would give an implicitly created parent the file mode.
RUN install -d -m 755 /opt/fieldproof
COPY --chmod=644 robot.yaml /opt/fieldproof/robot.yaml
# The readiness probe (fieldproof.vehicle_ready, copied unchanged): `fieldproof vehicle
# wait` runs it through docker exec against the manifest's runtime.ready conditions.
COPY --chmod=755 ready.py /usr/local/bin/fieldproof-vehicle-ready
# The same probe as the image's health check, so `docker inspect` and compose's
# `--wait` see the stack's readiness; the ROS environment comes from the entry point.
HEALTHCHECK --interval=15s --timeout=30s --start-period=60s --retries=3 \
    CMD ["/usr/local/bin/fieldproof-vehicle-entrypoint", "/usr/local/bin/fieldproof-vehicle-ready", "--timeout", "10"]
ENV FIELDPROOF_VEHICLE=example_ugv \
    FIELDPROOF_MANIFEST=/opt/fieldproof/robot.yaml

USER ${FIELDPROOF_USER}
WORKDIR /home/${FIELDPROOF_USER}
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/fieldproof-vehicle-entrypoint"]
CMD ["ros2", "launch", "example_ugv_bringup", "bringup.launch.py", "use_sim_time:=true", "drivers:=false"]

# OCI annotations; these ARGs sit last so a new revision or date invalidates no layer
# (BASE_IMAGE and ROSDISTRO_COMMIT are redeclared: ARGs do not cross a FROM).
ARG BASE_IMAGE
ARG ROSDISTRO_COMMIT=8e9a99d200fd312f106418b2b497b0cc5146e6a7
ARG GIT_SHA=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG VERSION=0.0.0
LABEL org.opencontainers.image.title="fieldproof-vehicle-example_ugv" \
      org.opencontainers.image.description="A yard UGV with its own waypoint navigator on wheel odometry (example repository)" \
      org.opencontainers.image.source="https://github.com/Dimitrios-Kafetzis/Fieldproof" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="Fieldproof" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      io.fieldproof.vehicle="example_ugv" \
      io.fieldproof.tier="T1" \
      io.fieldproof.manifest-api="fieldproof.dev/v0alpha1" \
      io.fieldproof.rosdistro-commit="${ROSDISTRO_COMMIT}"
