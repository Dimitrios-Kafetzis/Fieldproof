{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore(release): release ${version}",
  "pull-request-header": "Release prepared from the Conventional Commits merged to main since the last tag.",
  "pull-request-footer": "Merging this pull request tags the release and publishes the images.",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "build", "section": "Build and dependencies" },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "version-file": "version.txt",
      "extra-files": [
        { "type": "json", "path": "cockpit/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "cockpit/apps/cockpit/package.json", "jsonpath": "$.version" },
        {
          "type": "xml",
          "path": "sim/fieldproof_worlds/package.xml",
          "xpath": "//package/version"
        },
        {
          "type": "xml",
          "path": "sim/fieldproof_gz_plugins/package.xml",
          "xpath": "//package/version"
        },
        {
          "type": "xml",
          "path": "bridge/fieldproof_bridge/package.xml",
          "xpath": "//package/version"
        },
        {
          "type": "xml",
          "path": "robots/fieldproof_robots/package.xml",
          "xpath": "//package/version"
        },
        "bridge/fieldproof_bridge/fieldproof_bridge/__init__.py"
      ]
    }
  }
}
