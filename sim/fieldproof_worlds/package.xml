<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fieldproof_worlds</name>
  <version>0.17.1</version>
  <description>Gazebo Harmonic worlds for Fieldproof scenarios and the Fuel models they include</description>
  <maintainer email="dimitrioskafetzis@gmail.com">Dimitris Kafetzis</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://dimitrios-kafetzis.github.io/Fieldproof/</url>
  <url type="repository">https://github.com/Dimitrios-Kafetzis/Fieldproof</url>
  <url type="bugtracker">https://github.com/Dimitrios-Kafetzis/Fieldproof/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>python3-yaml</depend>

  <exec_depend>fieldproof_gz_plugins</exec_depend>
  <exec_depend>gz_sim_vendor</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-pytest</test_depend>
