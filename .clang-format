# Fieldproof C++ style (task P0-T04): Google style, 100 columns, C++17 (ADR-0009,
# 04-engineering-standards.md). Applied by the clang-format pre-commit hook to sim/ and bridge/.
---
Language: Cpp
BasedOnStyle: Google
Standard: c++17
ColumnLimit: 100
IndentWidth: 2
TabWidth: 2
UseTab: Never
AccessModifierOffset: -1
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IncludeBlocks: Regroup
IncludeCategories:
  # Matching header (handled by IncludeIsMainRegex), then project, ROS/Gazebo, system.
  - Regex: '^"fieldproof'
    Priority: 1
  - Regex: '^<(gz|sdf|rclcpp|rclpy|ros_gz|ament|tf2)'
    Priority: 2
  - Regex: '^<.*\.h>'
    Priority: 3
  - Regex: '^<'
    Priority: 4
  - Regex: '.*'
    Priority: 1
SortIncludes: CaseSensitive
InsertNewlineAtEOF: true
...
