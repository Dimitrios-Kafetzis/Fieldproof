          "default": null,
          "title": "Type"
        }
      },
      "required": ["service"],
      "title": "ServiceCondition",
      "type": "object"
    },
    "Tf": {
      "additionalProperties": false,
      "description": "The odometry transform the drive system publishes (`/tf` is global).",
      "properties": {
        "gz_topic": {
          "description": "Gazebo topic, relative to the model.",
          "title": "Gz Topic",
          "type": "string"
        },
        "gz_type": {
          "description": "Gazebo message type (`gz.msgs.X`).",
          "title": "Gz Type",
          "type": "string"
        },
        "ros_topic": {
          "description": "ROS topic the real driver uses.",
          "title": "Ros Topic",
          "type": "string"
        },
        "ros_type": {
          "description": "ROS message type (`pkg/msg/X`).",
          "title": "Ros Type",
          "type": "string"
        },
        "qos": {
          "$ref": "#/$defs/Qos"
        },
        "rate_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Hz"
        }
      },
      "required": ["gz_topic", "gz_type", "ros_topic", "ros_type"],
      "title": "Tf",
      "type": "object"
    },
    "TfCondition": {
      "additionalProperties": false,
