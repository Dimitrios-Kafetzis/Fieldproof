        "child": {
          "description": "Child (source) frame (`base_link`).",
          "title": "Child",
          "type": "string"
        }
      },
      "required": ["tf", "child"],
      "title": "TfCondition",
      "type": "object"
    },
    "TopicCondition": {
      "additionalProperties": false,
      "description": "A topic has a publisher.",
      "properties": {
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": ["topic"],
      "title": "TopicCondition",
      "type": "object"
    }
