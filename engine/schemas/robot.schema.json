        "gz_type": {
          "description": "Gazebo message type (`gz.msgs.X`).",
          "title": "Gz Type",
          "type": "string"
        },
        "ros_topic": {
          "description": "ROS topic the real driver uses.",
          "title": "Ros Topic",
          "type": "string"
        },
        "ros_type": {
          "description": "ROS message type (`pkg/msg/X`).",
          "title": "Ros Type",
          "type": "string"
        },
        "qos": {
          "$ref": "#/$defs/Qos"
        },
        "ros_frame_id": {
          "description": "Frame the ROS messages carry (relabelled if needed).",
