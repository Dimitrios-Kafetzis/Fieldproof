{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dimitrios-kafetzis.github.io/Fieldproof/schemas/scenario.schema.json",
  "$defs": {
    "Metadata": {
      "additionalProperties": false,
      "description": "What the scenario is.",
      "properties": {
        "name": {
          "description": "Scenario name: lower case, digits and underscores.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "One line about the scenario.",
          "title": "Description",
          "type": "string"
        },
        "tags": {
          "description": "Free labels (`smoke`, `nav`).",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": ["name"],
      "title": "Metadata",
      "type": "object"
    },
    "NavigateToPose": {
      "additionalProperties": false,
      "description": "Send a Nav2 `NavigateToPose` goal to a vehicle and wait for its result.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*(\\d+(\\.\\d+)?h)?\\s*(\\d+(\\.\\d+)?m)?\\s*(\\d+(\\.\\d+)?s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 0.0,
          "description": "When, after the vehicles are ready (`30s`, `1m`).",
          "title": "At"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Label in the run record (default: the action).",
          "title": "Name"
        },
        "vehicle": {
          "description": "The vehicle the goal goes to.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Vehicle",
          "type": "string"
        },
        "action": {
          "const": "navigate_to_pose",
          "title": "Action",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/Placement",
          "description": "The goal, in the world (frame or coordinates)."
        },
        "timeout_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*(\\d+(\\.\\d+)?h)?\\s*(\\d+(\\.\\d+)?m)?\\s*(\\d+(\\.\\d+)?s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 300.0,
          "description": "Give up on the result after this long.",
          "title": "Timeout S"
        }
      },
      "required": ["vehicle", "action", "goal"],
      "title": "NavigateToPose",
      "type": "object"
    },
    "NoCollision": {
      "additionalProperties": false,
      "description": "The vehicle's chassis touches nothing during the timeline.\n\nRead from the model's ground-truth contact sensor in Gazebo (the reference vehicles carry\none on the chassis, `<namespace>/contacts`); fails at the first contact.",
      "properties": {
        "name": {
          "description": "Assertion name: lower case, digits and underscores.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "no_collision",
          "title": "Type",
          "type": "string"
        },
        "vehicle": {
          "description": "The vehicle whose contact sensor is read.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Vehicle",
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gazebo topic of the `gz.msgs.Contacts` sensor (default: `<namespace>/contacts`).",
          "title": "Topic"
        },
        "ignore": {
          "description": "Entities whose contacts do not count (a model or collision name).",
          "items": {
            "type": "string"
          },
          "title": "Ignore",
          "type": "array"
        }
      },
      "required": ["name", "type", "vehicle"],
      "title": "NoCollision",
      "type": "object"
    },
    "Outputs": {
      "additionalProperties": false,
      "description": "What the run writes.",
      "properties": {
        "directory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run directory root (default: the workspace's `runs`).",
          "title": "Directory"
        },
        "record": {
          "default": false,
          "description": "Record the topics to MCAP with rosbag2 (`recording/` in the run directory).",
          "title": "Record",
          "type": "boolean"
        },
        "topics": {
          "description": "Topics to record (all if empty; the `/fieldproof/*` side channels always).",
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "logs": {
          "default": true,
          "description": "Keep the containers' logs in the run directory.",
          "title": "Logs",
          "type": "boolean"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoOutput"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Record a video of the run from a camera of the world (`video/<camera>.mp4` in the run directory); `true` uses the world's `spectator` camera.",
          "title": "Video"
        }
      },
      "title": "Outputs",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "A pose in the world: a named frame of the world file, or coordinates.\n\n`frame` and `x`/`y` are exclusive. `z` is optional with coordinates (the model's default\nspawn height, or the ground for a goal); `yaw` is in radians.",
      "properties": {
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A `<frame name>` of the world file.",
          "title": "Frame"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Z"
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yaw"
        }
      },
      "title": "Placement",
      "type": "object"
    },
    "ReachPose": {
      "additionalProperties": false,
      "description": "The vehicle's ground-truth pose comes within a tolerance of a target.\n\nPasses at the first ground-truth sample within `tolerance_m` of the target (and within\n`yaw_tolerance_rad` of its heading when given); fails when `within_s` passes first, or at\nthe end of the timeline. The evidence is the closest sample and the final pose.",
      "properties": {
        "name": {
          "description": "Assertion name: lower case, digits and underscores.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "reach_pose",
          "title": "Type",
          "type": "string"
        },
        "vehicle": {
          "description": "The vehicle whose ground-truth pose is read.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Vehicle",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Placement",
          "description": "The target, in the world (frame or coordinates)."
        },
        "tolerance_m": {
          "default": 0.5,
          "description": "Distance to the target, in metres.",
          "exclusiveMinimum": 0,
          "title": "Tolerance M",
          "type": "number"
        },
        "yaw_tolerance_rad": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Heading tolerance (absent: the heading is not checked).",
          "title": "Yaw Tolerance Rad"
        },
        "within_s": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "pattern": "^\\s*(\\d+(\\.\\d+)?h)?\\s*(\\d+(\\.\\d+)?m)?\\s*(\\d+(\\.\\d+)?s)?\\s*$",
                  "type": "string"
                }
              ],
              "description": "Seconds, or a duration such as '90s', '1m30s' or '2h'."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deadline after the timeline starts (absent: the end of the timeline).",
          "title": "Within S"
        }
      },
      "required": ["name", "type", "vehicle", "target"],
      "title": "ReachPose",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "description": "Container budget, in Docker's units (cgroup CPU quota, cpuset, memory, pids).",
      "properties": {
        "cpus": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`--cpus`: the CPU quota, in cores.",
          "title": "Cpus"
        },
        "cpuset": {
          "anyOf": [
            {
              "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`--cpuset-cpus`: the cores the container may run on (`0-1`, `0,2`).",
          "title": "Cpuset"
        },
        "memory": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]*(\\.[0-9]+)?[kKmMgG]?[bB]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`--memory` (`2g`).",
          "title": "Memory"
        },
        "pids": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`--pids-limit`.",
          "title": "Pids"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "Time": {
      "additionalProperties": false,
      "description": "The clock of the run (ADR-0006).",
      "properties": {
        "mode": {
          "default": "sim",
          "description": "`sim`: simulated time on /clock at the target real-time factor; `realtime`: real-time-locked mode (task P2-T04).",
          "enum": ["sim", "realtime"],
          "title": "Mode",
          "type": "string"
        },
        "rtf": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target real-time factor (absent: the world's own setting).",
          "title": "Rtf"
        },
        "tolerance": {
          "default": 0.1,
          "description": "Allowed deviation of the real-time factor from the target.",
          "exclusiveMinimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "timeout_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*(\\d+(\\.\\d+)?h)?\\s*(\\d+(\\.\\d+)?m)?\\s*(\\d+(\\.\\d+)?s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 600.0,
          "description": "Wall-clock budget of the run once every vehicle is ready.",
          "title": "Timeout S"
        }
      },
      "title": "Time",
      "type": "object"
    },
    "TopicRate": {
      "additionalProperties": false,
      "description": "A ROS topic keeps publishing at a rate.\n\nMeasured over a sliding window once `after_s` has passed after the timeline starts; fails\nat the first window below `min_hz` (or above `max_hz`) and at the end of the timeline if\nnothing was received.",
      "properties": {
        "name": {
          "description": "Assertion name: lower case, digits and underscores.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "topic_rate",
          "title": "Type",
          "type": "string"
        },
        "topic": {
          "description": "The topic (relative to the vehicle's namespace when `vehicle` is given).",
          "title": "Topic",
          "type": "string"
        },
        "vehicle": {
          "anyOf": [
            {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The vehicle the topic belongs to.",
          "title": "Vehicle"
        },
        "min_hz": {
          "description": "Lowest acceptable rate over a window.",
          "minimum": 0.0,
          "title": "Min Hz",
          "type": "number"
        },
        "max_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest acceptable rate.",
          "title": "Max Hz"
        },
        "window_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*(\\d+(\\.\\d+)?h)?\\s*(\\d+(\\.\\d+)?m)?\\s*(\\d+(\\.\\d+)?s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 5.0,
          "description": "Length of the measurement window.",
          "title": "Window S"
        },
        "after_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*(\\d+(\\.\\d+)?h)?\\s*(\\d+(\\.\\d+)?m)?\\s*(\\d+(\\.\\d+)?s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 0.0,
          "description": "Grace period after the timeline starts before windows count.",
          "title": "After S"
        },
        "message_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Message type (`sensor_msgs/msg/LaserScan`; absent: discovered).",
          "title": "Message Type"
        }
      },
      "required": ["name", "type", "topic", "min_hz"],
      "title": "TopicRate",
      "type": "object"
    },
    "TopicValue": {
      "additionalProperties": false,
      "description": "A condition over a field of a ROS topic's messages.\n\n`condition` is an expression over `value`, the field of each message (`value < 1.5`,\n`abs(value) <= 0.2`, `0 < value and value < 2`); `mode` says whether every message after\n`after_s` must satisfy it (`always`, fails at the first that does not) or one must\n(`eventually`, passes at the first that does, fails at `within_s` or the end).",
      "properties": {
        "name": {
          "description": "Assertion name: lower case, digits and underscores.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "topic_value",
          "title": "Type",
          "type": "string"
        },
        "topic": {
          "description": "The topic (relative to the vehicle's namespace when `vehicle` is given).",
          "title": "Topic",
          "type": "string"
        },
        "vehicle": {
          "anyOf": [
            {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The vehicle the topic belongs to.",
          "title": "Vehicle"
        },
        "field": {
          "description": "Field of the message (`twist.linear.x`, `ranges[0]`, `status.status`).",
          "title": "Field",
          "type": "string"
        },
        "condition": {
          "description": "Expression over `value` (comparisons, arithmetic, abs).",
          "title": "Condition",
          "type": "string"
        },
        "mode": {
          "default": "always",
          "enum": ["always", "eventually"],
          "title": "Mode",
          "type": "string"
        },
        "after_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^\\s*(\\d+(\\.\\d+)?h)?\\s*(\\d+(\\.\\d+)?m)?\\s*(\\d+(\\.\\d+)?s)?\\s*$",
              "type": "string"
            }
          ],
          "default": 0.0,
          "description": "Grace period after the timeline starts before messages count.",
          "title": "After S"
        },
        "within_s": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "pattern": "^\\s*(\\d+(\\.\\d+)?h)?\\s*(\\d+(\\.\\d+)?m)?\\s*(\\d+(\\.\\d+)?s)?\\s*$",
                  "type": "string"
                }
              ],
              "description": "Seconds, or a duration such as '90s', '1m30s' or '2h'."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deadline for `eventually` (absent: the end of the timeline).",
          "title": "Within S"
        },
        "message_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Message type (`geometry_msgs/msg/Twist`; absent: discovered).",
          "title": "Message Type"
        }
      },
      "required": ["name", "type", "topic", "field", "condition"],
      "title": "TopicValue",
      "type": "object"
    },
    "Vehicle": {
      "additionalProperties": false,
      "description": "One vehicle of the scenario.\n\nIn a fleet every vehicle has its own `namespace`: its Gazebo topics, its ROS topics (the TF\ntopics included, Nav2's multi-robot convention) and its nodes live under it, so nothing of\none vehicle reaches another. `frame_prefix` is for a stack that keeps one shared `/tf` tree\ninstead and tells its frames apart by name (REP 105); it is passed to the spawn, the bridge\nand the vehicle's launch (`runtime.entrypoint.launch.frame_prefix_arg`).",
      "properties": {
        "name": {
          "description": "Vehicle name: the model name in Gazebo and the container.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "manifest": {
          "description": "Vehicle manifest (robot.yaml), relative to the scenario.",
          "title": "Manifest",
          "type": "string"
        },
        "namespace": {
          "default": "",
          "description": "ROS and Gazebo namespace of the vehicle (empty: the root).",
          "pattern": "^([a-z][a-z0-9_]*)?$",
          "title": "Namespace",
          "type": "string"
        },
        "frame_prefix": {
          "default": "",
          "description": "Prefix of every frame of the vehicle (`ugv1/`, `ugv1_`; empty: none).",
          "pattern": "^([a-z][a-z0-9_]*[/_]?)?$",
          "title": "Frame Prefix",
          "type": "string"
        },
        "spawn": {
          "$ref": "#/$defs/Placement"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image to run instead of the manifest's.",
          "title": "Image"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra environment of the vehicle container.",
          "title": "Env",
          "type": "object"
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resources"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Budget of the vehicle container; fields set here replace the manifest's `runtime.resources` (`cpus`, `cpuset`, `memory`, `pids`)."
        },
        "depends_on": {
          "description": "Vehicles that must be ready before this one's container starts (start order within the fleet; the others start in parallel).",
          "items": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": ["name", "manifest", "spawn"],
      "title": "Vehicle",
      "type": "object"
    },
    "VideoOutput": {
      "additionalProperties": false,
      "description": "A video of the run from a camera of the world (issue #46).\n\nThe camera is a `<sensor type=\"camera\">` of the world file with Gazebo's\n`CameraVideoRecorder` system attached; the runner starts the recording when the timeline\nstarts, stops it when the timeline ends and copies the file into the run directory.",
      "properties": {
        "camera": {
          "default": "spectator",
          "description": "Name of the world's camera sensor (its recorder service is `/<camera>/record_video`).",
          "minLength": 1,
          "title": "Camera",
          "type": "string"
        },
        "format": {
          "const": "mp4",
          "default": "mp4",
          "description": "Container format of the file.",
          "title": "Format",
          "type": "string"
        }
      },
      "title": "VideoOutput",
      "type": "object"
    },
    "WithinTime": {
      "additionalProperties": false,
      "description": "A timeline action completes successfully within a duration of its start.",
      "properties": {
        "name": {
          "description": "Assertion name: lower case, digits and underscores.",
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "within_time",
          "title": "Type",
          "type": "string"
        },
        "action": {
          "description": "The `name` of a timeline entry.",
          "title": "Action",
          "type": "string"
        },
        "max_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
