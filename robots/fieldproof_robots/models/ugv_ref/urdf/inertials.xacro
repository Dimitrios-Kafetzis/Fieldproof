<?xml version="1.0"?>
<!--
  Inertial macros for the reference vehicles (task P1-T01): solid box, cylinder (axis along z) and
  sphere. Each takes the mass and the dimensions and an <origin> block for the centre of mass.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass / 12 * (y * y + z * z)}" ixy="0" ixz="0"
               iyy="${mass / 12 * (x * x + z * z)}" iyz="0"
               izz="${mass / 12 * (x * x + y * y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass / 12 * (3 * radius * radius + length * length)}" ixy="0" ixz="0"
               iyy="${mass / 12 * (3 * radius * radius + length * length)}" iyz="0"
               izz="${mass / 2 * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${2 / 5 * mass * radius * radius}" ixy="0" ixz="0"
               iyy="${2 / 5 * mass * radius * radius}" iyz="0"
               izz="${2 / 5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <!--
    A sensor housing: a small link with the given geometry (one <box>, <cylinder> or <sphere>
    element passed as the block), a box inertia approximating it, fixed to `parent` at xyz/rpy.
    The link is named <name>_link and the joint <name>_joint, both with the frame prefix.
  -->
  <xacro:macro name="sensor_link" params="name parent xyz rpy mass *geometry">
    <link name="${prefix}${name}_link">
      <visual>
        <geometry>
          <xacro:insert_block name="geometry"/>
        </geometry>
        <material name="light_grey"/>
      </visual>
      <xacro:box_inertial mass="${mass}" x="0.05" y="0.05" z="0.03">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>
    <joint name="${prefix}${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
</robot>
