<?xml version="1.0"?>
<!-- Gazebo model manifest (task P1-T01): lets `model://ugv_ref` resolve once models/ is on
     GZ_SIM_RESOURCE_PATH. model.sdf is generated at build time from urdf/ugv_ref.urdf.xacro. -->
<model>
  <name>ugv_ref</name>
  <version>1.0</version>
  <sdf version="1.11">model.sdf</sdf>
  <author>
    <name>Dimitris Kafetzis</name>
    <email>dimitrioskafetzis@gmail.com</email>
  </author>
  <description>
    Fieldproof reference differential-drive UGV: chassis, two drive wheels, two casters, 2D lidar,
    IMU, RGB-D camera and GNSS receiver, with Gazebo DiffDrive and JointStatePublisher systems.
  </description>
</model>
