<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fieldproof_robots</name>
  <version>0.18.0</version>
  <description>Reference vehicle descriptions (UGV, UAV, USV) and manifests for Fieldproof</description>
  <maintainer email="dimitrioskafetzis@gmail.com">Dimitris Kafetzis</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://dimitrios-kafetzis.github.io/Fieldproof/</url>
  <url type="repository">https://github.com/Dimitrios-Kafetzis/Fieldproof</url>
  <url type="bugtracker">https://github.com/Dimitrios-Kafetzis/Fieldproof/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The descriptions are rendered to URDF and SDF at build time. -->
  <build_depend>xacro</build_depend>
  <build_depend>gz_tools_vendor</build_depend>

  <!-- Spawn launch files: xacro at launch time, robot_state_publisher, ros_gz_sim create. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>fieldproof_worlds</test_depend>
  <test_depend>gz_msgs_vendor</test_depend>
  <test_depend>gz_sim_vendor</test_depend>
  <test_depend>gz_tools_vendor</test_depend>
  <test_depend>gz_transport_vendor</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>urdfdom</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
