<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fieldproof_bridge</name>
  <version>0.4.0</version>
  <description>ros_gz bridge configuration generator and adapter nodes for Fieldproof vehicles</description>
  <maintainer email="dimitrioskafetzis@gmail.com">Dimitris Kafetzis</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://dimitrios-kafetzis.github.io/Fieldproof/</url>
  <url type="repository">https://github.com/Dimitrios-Kafetzis/Fieldproof</url>
  <url type="bugtracker">https://github.com/Dimitrios-Kafetzis/Fieldproof/issues</url>

  <depend>rclpy</depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
