<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fieldproof_bridge</name>
  <version>0.13.0</version>
  <description>ros_gz bridge configuration generator and adapter nodes for Fieldproof vehicles</description>
  <maintainer email="dimitrioskafetzis@gmail.com">Dimitris Kafetzis</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://dimitrios-kafetzis.github.io/Fieldproof/</url>
  <url type="repository">https://github.com/Dimitrios-Kafetzis/Fieldproof</url>
  <url type="bugtracker">https://github.com/Dimitrios-Kafetzis/Fieldproof/issues</url>

  <!-- Generator (plain Python) and contract checker. -->
  <depend>python3-yaml</depend>
  <depend>rclpy</depend>
  <depend>rosidl_runtime_py</depend>
  <!-- Adapter nodes. -->
  <depend>sensor_msgs</depend>
  <!-- What the bridge launch starts. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>fieldproof_robots</test_depend>
  <test_depend>fieldproof_worlds</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>gz_sim_vendor</test_depend>
  <test_depend>gz_tools_vendor</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ros_gz_sim</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
